# Salin menjadi .env lalu sesuaikan
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://sarpras:sarpras@localhost:5432/sarpras
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES=12h
# URL publik (dipakai di QR code aset & QR pintu ruangan)
PUBLIC_URL=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
TZ_DB=Asia/Jakarta
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=admin123

# Asisten Rendra (opsional). Tanpa kunci, Rendra berjalan dalam mode dasar.
# ANTHROPIC_API_KEY=
# RENDRA_MODEL=claude-haiku-5-5
# RENDRA_RATE_PER_MIN=20
