# Salin menjadi .env lalu sesuaikan
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://sarpras:sarpras@localhost:5432/sarpras
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES=12h
# URL publik (dipakai di QR code aset & QR pintu ruangan)
# Contoh produksi subpath: https://u-talent.uika-bogor.ac.id/sarpras
PUBLIC_URL=http://localhost:3000
# Subpath dasar (opsional jika PUBLIC_URL sudah berisi subpath, misal /sarpras)
BASE_PATH=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
TZ_DB=Asia/Jakarta
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=admin123
